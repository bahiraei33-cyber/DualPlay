<Window x:Class="DualPlay.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DualPlay" Height="490" Width="410"
        MinHeight="470" MinWidth="380"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgBrush}"
        Foreground="{StaticResource TextBrush}"
        FontFamily="Segoe UI"
        ResizeMode="CanMinimize">
  <Window.Resources>
    <Style x:Key="TabButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Background" Value="{StaticResource PanelBrush}"/>
      <Setter Property="FontWeight" Value="Medium"/>
      <Setter Property="Padding" Value="8,12"/>
    </Style>
  </Window.Resources>
  <Grid Margin="20">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <DockPanel Grid.Row="0" Margin="2,0,2,20">
      <TextBlock Text="◖))" FontSize="24" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center" Margin="0,0,10,0"/>
      <TextBlock Text="DualPlay" FontSize="22" FontWeight="SemiBold" VerticalAlignment="Center"/>
    </DockPanel>

    <Grid Grid.Row="1" Margin="0,0,0,18">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>
      <Button x:Name="DualTab" Grid.Column="0" Style="{StaticResource TabButton}" Margin="0,0,5,0" Click="DualTab_Click">
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
          <TextBlock Text="♫" FontSize="17" Margin="0,0,7,0"/>
          <TextBlock Text="Dual Play"/>
        </StackPanel>
      </Button>
      <Button x:Name="ReverseTab" Grid.Column="1" Style="{StaticResource TabButton}" Margin="5,0,0,0" Click="ReverseTab_Click">
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
          <TextBlock Text="▣ → ◖))" FontSize="14" Margin="0,0,7,0"/>
          <TextBlock Text="Reverse Play"/>
        </StackPanel>
      </Button>
    </Grid>

    <Grid Grid.Row="2">
      <StackPanel x:Name="DualPanel">
        <TextBlock Text="♫   ))    ♫" FontSize="44" Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Center" Margin="0,8,0,22"/>
        <TextBlock Text="First headphones" Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="2,0,0,6"/>
        <ComboBox x:Name="FirstDevice" DisplayMemberPath="Name" SelectionChanged="Device_SelectionChanged" Margin="0,0,0,14"/>
        <TextBlock Text="Second headphones" Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="2,0,0,6"/>
        <ComboBox x:Name="SecondDevice" DisplayMemberPath="Name" SelectionChanged="Device_SelectionChanged"/>
      </StackPanel>
      <StackPanel x:Name="ReversePanel" Visibility="Collapsed">
        <TextBlock Text="▣   ))))   ▰" FontSize="44" Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Center" Margin="0,8,0,22"/>
        <TextBlock Text="Phone audio via Bluetooth" FontSize="14" HorizontalAlignment="Center" Margin="0,0,0,8"/>
        <TextBlock Text="The phone must connect as a Bluetooth audio source. Windows 11 does not support this on every PC by default."
                   Foreground="{StaticResource MutedBrush}" FontSize="12" TextWrapping="Wrap" TextAlignment="Center" Margin="12,0,12,0"/>
      </StackPanel>
    </Grid>

    <StackPanel Grid.Row="3" Margin="0,20,0,0">
      <Button x:Name="ActionButton" Content="Enable Dual Play" Height="46" Click="ActionButton_Click"/>
      <TextBlock x:Name="StatusText" Text="Choose two connected audio devices." Foreground="{StaticResource MutedBrush}"
                 FontSize="11" TextAlignment="Center" TextWrapping="Wrap" Margin="4,10,4,0"/>
    </StackPanel>
  </Grid>
</Window>
